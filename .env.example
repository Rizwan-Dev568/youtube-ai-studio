# ==========================================
# YouTube AI Studio
# Environment Configuration
# ==========================================

# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary Model
PRIMARY_MODEL=poolside/laguna-m.1:free

# Fallback Models
FALLBACK_MODEL_1=deepseek/deepseek-chat-v3-0324:free
FALLBACK_MODEL_2=qwen/qwen3-235b-a22b:free
FALLBACK_MODEL_3=google/gemma-3-27b-it:free

# Optional
LOG_LEVEL=INFO
CACHE_ENABLED=true
AUTO_RESUME=true